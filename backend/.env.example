# ---- Server ----
NODE_ENV=development
PORT=5000
# Public URL of the Next.js app (used for CORS)
CLIENT_URL=http://localhost:3000

# ---- Database (PostgreSQL) ----
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/dream_craft_events?schema=public"

# ---- JWT ----
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_ACCESS_SECRET must be the SAME value in frontend/.env.local
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Set to true only when serving over HTTPS
COOKIE_SECURE=false

# Seeded demo accounts (password for all of them)
DEMO_PASSWORD=Demo@1234
# One-click demo login buttons (set false in real production)
ENABLE_DEMO_LOGIN=true
